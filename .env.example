# Copy this file to .env and fill in values as needed.
# Secrets should NEVER be committed to version control.

# SQLite database path override
DATABASE_PATH=data/pipeline.db

# Optional API keys for authenticated REST sources
CRYPTO_API_KEY=
REST_API_TOKEN=

# Webhook URL for alerts (Slack, Discord, Teams, or custom JSON receiver).
# Leave empty to automatically use local JSONL fallback logging.
ALERT_WEBHOOK_URL=

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
